  npcScript:
  - nameCharacter1: "Th\u1EA7n ???"
    avatarCharacter1: {fileID: 3733519124693108528, guid: c268ccf4e97ad9c4e8521a16fb812ee3, type: 3}
    contentForPanel1: "Ch\xE0o m\u1EEBng nh\xE0 th\xE1m hi\u1EC3m !!\nCu\u1ED1i c\xF9ng
      ta c\u0169ng \u0111\u1EE3i \u0111\u01B0\u1EE3c c\u1EADu..."
    nameCharacter2: "Chi\u1EBFn Binh"
    avatarCharacter2: {fileID: -7570986889122909192, guid: 8a8b5ae2bfa3dcf42b713b953439ad8d, type: 3}
    contentForPanel2: "Ng\xE0i l\xE0 ai ??\n"
  - nameCharacter1: "Th\u1EA7n ???"
    avatarCharacter1: {fileID: 3733519124693108528, guid: c268ccf4e97ad9c4e8521a16fb812ee3, type: 3}
    contentForPanel1: "Ta l\xE0 m\u1ED9t t\u1ED3n t\u1EA1i \u0111\u01B0\u1EE3c l\u01B0u
      l\u1EA1i \u1EDF n\u01A1i n\xE0y t\u1EEB l\xE2u l\u1EAFm r\u1ED3i..C\u1EADu
      c\xF3 th\u1EC3 g\u1ECDi ta l\xE0 g\xEC c\u0169ng \u0111\u01B0\u1EE3c"
    nameCharacter2: "Chi\u1EBFn Binh"
    avatarCharacter2: {fileID: -7570986889122909192, guid: 8a8b5ae2bfa3dcf42b713b953439ad8d, type: 3}
    contentForPanel2: "V\u1EADy... t\u1EA1i sao ng\xE0i l\u1EA1i n\xF3i \u0111\xE3
      \u0111\u1EE3i t\xF4i t\u1EEB l\xE2u r\u1ED3i"
  - nameCharacter1: "Th\u1EA7n ???"
    avatarCharacter1: {fileID: 3733519124693108528, guid: c268ccf4e97ad9c4e8521a16fb812ee3, type: 3}
    contentForPanel1: "V\xEC ta mu\u1ED1n cho c\u1EADu bi\u1EBFt s\u1EF1 th\u1EADt
      v\u1EC1 th\u1EBF gi\u1EDBi n\xE0y..R\u1EB1ng n\u1EEF th\u1EA7n \u0111\xE3 l\u1EEBa
      d\u1ED1i c\u1EADu!!"
    nameCharacter2: "Chi\u1EBFn Binh"
    avatarCharacter2: {fileID: -7570986889122909192, guid: 8a8b5ae2bfa3dcf42b713b953439ad8d, type: 3}
    contentForPanel2: "N\u1EEF Th\u1EA7n....L\u1EEAA D\u1ED0I T\xD4I SAO!!!"
  - nameCharacter1: "Th\u1EA7n ???"
    avatarCharacter1: {fileID: 3733519124693108528, guid: c268ccf4e97ad9c4e8521a16fb812ee3, type: 3}
    contentForPanel1: "T\u1EEB x\u01B0a n\u1EEF th\u1EA7n v\xEC mu\u1ED1n c\xF3 \u0111\u01B0\u1EE3c
      s\u1EE9c m\u1EA1nh to l\u1EDBn h\u01A1n \u0111\xE3 t\u1EA1o ra c\xE1c con qu\xE1i
      v\u1EADt \u0111\u1EE9ng \u0111\u1EA7u c\xE1c h\u1EA7m ng\u1EE5c \u0111\u1EC3
      d\u1EE5 d\u1ED7 c\xE1c sinh linh ti\u1EBFn v\xE0o d\xE2ng hi\u1EBFn sinh m\u1EC7nh
      c\u1EE7a m\xECnh.. "
    nameCharacter2: "Th\u1EA7n ???"
    avatarCharacter2: {fileID: 3733519124693108528, guid: c268ccf4e97ad9c4e8521a16fb812ee3, type: 3}
    contentForPanel2: "L\xE2u d\u1EA7n c\xE1c sinh linh kh\xE1c v\xE0 c\u1EA3 con
      ng\u01B0\u1EDDi b\u1ECB ti\xEAu di\u1EC7t kh\xF4ng c\xF2n l\u1EA1i bao nhi\xEAu..C\xE1c
      con qu\xE1i trong h\u1EA7m ng\u1EE5c \u0111\xE3 c\xF3 \u0111\u01B0\u1EE3c s\u1EE9c
      m\u1EA1nh to l\u1EDBn v\xE0 tho\xE1t ra \u0111\u01B0\u1EE3c kh\u1ECFi s\u1EF1
      kh\u1ED1ng ch\u1EBF c\u1EE7a N\u1EEF Th\u1EA7n..!"
  - nameCharacter1: "Th\u1EA7n ???"
    avatarCharacter1: {fileID: 3733519124693108528, guid: c268ccf4e97ad9c4e8521a16fb812ee3, type: 3}
    contentForPanel1: "V\xEC th\u1EBF c\xF4 ta \u0111\xE3 t\xECm \u0111\u1EBFn v\xE0
      d\u1EABn l\u1ED1i cho c\u1EADu \u0111i ti\xEAu di\u1EC7t t\u1EA5t c\u1EA3 b\u1ECDn
      ch\xFAng..V\xEC ch\u1EC9 c\xF3 th\u1EBF c\xF4 ta m\u1EDBi c\xF3 l\u1EA1i to\xE0n
      b\u1ED9 s\u1EE9c m\u1EA1nh \u0111\xF3 ..."
    nameCharacter2: "Chi\u1EBFn Binh"
    avatarCharacter2: {fileID: -7570986889122909192, guid: 8a8b5ae2bfa3dcf42b713b953439ad8d, type: 3}
    contentForPanel2: "Sao t\xF4i ph\u1EA3i tin Ng\xE0i...L\u1EE1 nh\u01B0 ng\xE0i
      c\u0169ng \u0111\u1EBFn l\u1EEBa g\u1EA1t t\xF4i th\xEC sao!!"
  - nameCharacter1: "Th\u1EA7n ???"
    avatarCharacter1: {fileID: 3733519124693108528, guid: c268ccf4e97ad9c4e8521a16fb812ee3, type: 3}
    contentForPanel1: "\u0110\xF3 l\xE0 l\u1EF1a ch\u1ECDn c\u1EE7a c\u1EADu..T\xF4i
      kh\xF4ng th\u1EC3 can thi\u1EC7p "
    nameCharacter2: "Chi\u1EBFn Binh"
    avatarCharacter2: {fileID: -7570986889122909192, guid: 8a8b5ae2bfa3dcf42b713b953439ad8d, type: 3}
    contentForPanel2: "V\u1EADy n\u1EBFu ng\xE0i n\xF3i l\xE0 s\u1EF1 th\u1EADt th\xEC
      t\xF4i c\u1EA7n l\xE0m g\xEC ??"
  - nameCharacter1: "Th\u1EA7n ???"
    avatarCharacter1: {fileID: 3733519124693108528, guid: c268ccf4e97ad9c4e8521a16fb812ee3, type: 3}
    contentForPanel1: "Ta s\u1EBD m\u1EDF cho c\u1EADu m\u1ED9t l\u1ED1i \u0111i
      \u0111\u1EC3 \u0111\u1EBFn n\u01A1i \u1EDF c\u1EE7a N\u1EEF Th\u1EA7n..Nh\u01B0ng
      \u0111\u1EC3 m\u1EDF c\xE1nh c\u1ED5ng v\xE0o b\xEAn trong , c\u1EADu ph\u1EA3i
      t\xECm \u0111\u01B0\u1EE3c 8 vi\xEAn \u0111\xE1 linh h\u1ED3n cho 8 c\u1ED9t..."
    nameCharacter2: "Chi\u1EBFn Binh"
    avatarCharacter2: {fileID: -7570986889122909192, guid: 8a8b5ae2bfa3dcf42b713b953439ad8d, type: 3}
    contentForPanel2: "8 vi\xEAn \u0111\xE1 linh h\u1ED3n sao....."

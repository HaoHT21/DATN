      propertyPath: npcScript.Array.data[0].contentForPanel1
      value: "Ng\u01B0\u1EDDi th\u1EADt s\u1EF1 \u0111\xE3 l\u1EEBa g\u1EA1t t\xF4i
        sao..."
      objectReference: {fileID: 0}
    - target: {fileID: 8560670650662352527, guid: 6cd8f4152ade37e4bb9bc4c54e0ace8b, type: 3}
      propertyPath: npcScript.Array.data[0].contentForPanel2
      value: "\u0110\u1EBFn b\xE2y gi\u1EDD ng\u01B0\u01A1i v\u1EABn ch\u01B0a hi\u1EC3u
        sao...Ta \u0111\u1EBFn \u0111\xE2y \u0111\u1EC3 \u0111o\u1EA1t l\u1EA5y m\u1EA1ng
        s\u1ED1ng v\xE0 linh h\u1ED3n ng\u01B0\u01A1i \u0111\xE2y.!!!"
      objectReference: {fileID: 0}
    - target: {fileID: 8560670650662352527, guid: 6cd8f4152ade37e4bb9bc4c54e0ace8b, type: 3}
      propertyPath: npcScript.Array.data[1].avatarCharacter2
      value: 
      objectReference: {fileID: 5197218762521719600, guid: 609e4f9eb7f29724e8a4ecaa0919d7ec, type: 3}
    - target: {fileID: 8560670650662352527, guid: 6cd8f4152ade37e4bb9bc4c54e0ace8b, type: 3}
      propertyPath: npcScript.Array.data[1].contentForPanel1
      value: "T\xF4i kh\xF4ng ng\u1EDD ng\u01B0\u1EDDi l\u1EA1i \u0111i l\u1EEBa
        g\u1EA1t t\xF4i!!!!"
      objectReference: {fileID: 0}
    - target: {fileID: 8560670650662352527, guid: 6cd8f4152ade37e4bb9bc4c54e0ace8b, type: 3}
      propertyPath: npcScript.Array.data[1].contentForPanel2
      value: "M\u1ED9t con s\xE2u ki\u1EBFn nh\u01B0 ng\u01B0\u01A1i th\xEC x\u1EE9ng
        \u0111\xE1ng b\u1ECB nh\u01B0 v\u1EADy..HAHAHA"
      objectReference: {fileID: 0}
    - target: {fileID: 8560670650662352527, guid: 6cd8f4152ade37e4bb9bc4c54e0ace8b, type: 3}
      propertyPath: npcScript.Array.data[2].contentForPanel1
      value: "GZZZ....Ta s\u1EBD kh\xF4ng b\u1ECF qua cho ng\u01B0\u01A1i !!!!!!!"
      objectReference: {fileID: 0}
    - target: {fileID: 8560670650662352527, guid: 6cd8f4152ade37e4bb9bc4c54e0ace8b, type: 3}
      propertyPath: npcScript.Array.data[2].contentForPanel2
      value: "Th\u1EBF th\xEC \u0111\u1EBFn \u0111\xE2y lo\xE0i s\xE2u ki\u1EBFn
